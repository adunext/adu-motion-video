          "title": "title",
          "feedback-0": "feedback-0",
          "feedback-1": "feedback-1",
          "feedback-2": "feedback-2",
          "container": "container",
          "aggregation": "aggregation",
          "update": "update"
        },
        "splitPolicy": {
          "mode": "atomic",
          "reason": "三个反馈的吸入终点等于同一个更新容器；升级必须发生在反馈到达后。"
        },
        "audio": {
          "mode": "source-remap",
          "tailPolicy": "preserve",
          "notes": "源动作SFX、冲击与混响尾音保留；默认新合成配乐，旧录音不分发。相邻组与最终音画须听审。"
        }
      }
    ]
  }
}
